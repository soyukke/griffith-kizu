import griffith::codegen;
import griffith::core;
import griffith::lut;
import griffith::model;
import griffith::synth;
import std::array;
import std::math;
import std::mem;
import std::string;
import std::testing;

pub fn dl_in_dim() -> i64 { return 64; }
pub fn dl_teacher_h() -> i64 { return 32; }
pub fn dl_h1() -> i64 { return 64; }
pub fn dl_h2() -> i64 { return 64; }
pub fn dl_h3() -> i64 { return 32; }
pub fn dl_num_classes() -> i64 { return 4; }
pub fn dl_max_samples() -> i64 { return 128; }
pub fn dl_total_gates() -> i64 { return 64 + 64 + 32; }
pub fn dl_opt_cap() -> i64 { return 384; }
pub fn dl_teacher_muls() -> i64 { return 64 * 32 + 32 * 4; }

fn fnv_mix(h: u32, b: u8) -> u32 {
    return (h ^ cast<u32>(b)) * cast<u32>(16777619);
}

/// Zero-dictionary codepoint-aligned UTF-8 Japanese 64-bit binary fingerprint.
/// Walks UTF-8 leading bytes (0 vocabulary memory): hashes content unigrams
/// (kanji / katakana / ASCII alnum) + 2-character UTF-8 bigrams into bits 0..61,
/// and maps '?'/'？' -> bit 62, '!'/'！' -> bit 63 for crisp ~25% bit density.
pub fn jp_encode_utf8_64(bytes: []u8) -> u64 {
    let n = mem::len(bytes);
    var mask: u64 = 0;
    let seed: u32 = 2166136261;

    var starts = [65]i64{};
    var cp_n: i64 = 0;
    for 0..n |i| {
        if (bytes[i] & cast<u8>(0xC0)) != cast<u8>(0x80) {
            if cp_n < 64 {
                starts[cp_n] = i;
                cp_n = cp_n + 1;
            }
        }
    }
    starts[cp_n] = n;

    for 0..cp_n |c| {
        let s0 = starts[c];
        let e0 = starts[c + 1];
        let l0 = e0 - s0;
        if l0 == 1 {
            let b0 = bytes[s0];
            if b0 == 63 { mask = mask | (cast<u64>(1) << 62); }
            if b0 == 33 { mask = mask | (cast<u64>(1) << 63); }
            let is_alnum = (b0 >= 48 and b0 <= 57) or (b0 >= 65 and b0 <= 90) or (b0 >= 97 and b0 <= 122);
            if is_alnum {
                let h = fnv_mix(seed ^ cast<u32>(0x5a5a5a5a), b0);
                let bit = cast<u64>(h % cast<u32>(62));
                mask = mask | (cast<u64>(1) << bit);
            }
        } else if l0 == 3 {
            let b0 = bytes[s0];
            let b1 = bytes[s0 + 1];
            let b2 = bytes[s0 + 2];
            if b0 == 239 and b1 == 188 and b2 == 159 { mask = mask | (cast<u64>(1) << 62); }
            if b0 == 239 and b1 == 188 and b2 == 129 { mask = mask | (cast<u64>(1) << 63); }
            let is_kanji = b0 >= 228 and b0 <= 233;
            let is_kata = b0 == 227 and ((b1 == 130 and b2 >= 160) or b1 == 131);
            if is_kanji or is_kata {
                let h = fnv_mix(fnv_mix(fnv_mix(seed ^ cast<u32>(0x5a5a5a5a), b0), b1), b2);
                let bit = cast<u64>(h % cast<u32>(62));
                mask = mask | (cast<u64>(1) << bit);
            }
        }

        if c + 1 < cp_n {
            let e1 = starts[c + 2];
            var h = seed ^ cast<u32>(0x3c3c3c3c);
            for s0..e1 |k| {
                h = fnv_mix(h, bytes[k]);
            }
            let bit = cast<u64>(h % cast<u32>(62));
            mask = mask | (cast<u64>(1) << bit);
        }
    }
    return mask;
}

pub struct StudentNet {
    pub l1: lut::LutLayer,
    pub l2: lut::LutLayer,
    pub l3: lut::LutLayer,
    pub gs: lut::GroupSum,
}

pub fn (self: StudentNet) deinit(allocator: Allocator) -> void {
    self.l1.deinit(allocator);
    self.l2.deinit(allocator);
    self.l3.deinit(allocator);
    return;
}

fn student_new(allocator: Allocator, seed: u64) -> mem::Error!StudentNet {
    var rng = core::rng_new(seed);
    let max_b = dl_max_samples();
    // Layer 1 uses N=4 WARP LUTs (64 gates x 4 inputs = 256 wires over 64-bit UTF-8 fingerprint!)
    var l1 = try lut::lut_layer_new(allocator, dl_in_dim(), dl_h1(), 4, lut::ParamMode::Warp, lut::SelectMode::Soft, 1.0, 0.20, max_b, &var rng);
    errdefer l1.deinit(allocator);
    var l2 = try lut::lut_layer_new(allocator, dl_h1(), dl_h2(), 2, lut::ParamMode::Warp, lut::SelectMode::Soft, 1.0, 0.20, max_b, &var rng);
    errdefer l2.deinit(allocator);
    var l3 = try lut::lut_layer_new(allocator, dl_h2(), dl_h3(), 2, lut::ParamMode::Warp, lut::SelectMode::Soft, 1.0, 0.20, max_b, &var rng);
    errdefer l3.deinit(allocator);
    return StudentNet {
        l1: move l1,
        l2: move l2,
        l3: move l3,
        gs: lut::groupsum_new(dl_h3(), dl_num_classes(), 1.0),
    };
}

pub struct DistillLab {
    pub rng: core::Rng,
    pub teacher_step: i64,
    pub student_step: i64,

    // Dataset (labeled train + held-out val + unlabeled Japanese stream for Teacher KD)
    pub train_count: i64,
    pub train_fp: array::Array<u64>,
    pub train_labels: array::Array<i32>,
    pub val_count: i64,
    pub val_fp: array::Array<u64>,
    pub val_labels: array::Array<i32>,
    pub unlab_count: i64,
    pub unlab_fp: array::Array<u64>,

    // Real FP32 Teacher MLP: 64 -> 32 (GELU) -> 4
    pub t_fc1: model::LinearLayer,
    pub t_fc2: model::LinearLayer,
    pub teacher_train_logits: array::Array<f32>,
    pub teacher_val_preds: array::Array<i32>,

    // Two identical-init Student LUT networks: Scratch (CE) vs Distilled (L0 KL)
    pub scratch: StudentNet,
    pub kd: StudentNet,

    // Shared preallocated scratch buffers
    pub x_buf: array::Array<f32>,
    pub th_pre: array::Array<f32>,
    pub th_act: array::Array<f32>,
    pub t_logits: array::Array<f32>,
    pub t_glogits: array::Array<f32>,
    pub t_gh1: array::Array<f32>,
    pub t_gh0: array::Array<f32>,
    pub t_gx: array::Array<f32>,

    pub s_a1: array::Array<f32>,
    pub s_a2: array::Array<f32>,
    pub s_a3: array::Array<f32>,
    pub s_logits: array::Array<f32>,
    pub s_glogits: array::Array<f32>,
    pub s_ga3: array::Array<f32>,
    pub s_ga2: array::Array<f32>,
    pub s_ga1: array::Array<f32>,
    pub s_gx: array::Array<f32>,

    // Telemetry
    pub teacher_train_acc: f32,
    pub teacher_val_acc: f32,
    pub scratch_loss: f32,
    pub scratch_train_acc: f32,
    pub scratch_val_acc: f32,
    pub kd_loss: f32,
    pub kd_train_acc: f32,
    pub kd_val_acc: f32,
    pub kd_teacher_agree: f32,

    // Synthesized minimal Bit-Slice circuit for KD student
    pub has_synth: bool,
    pub opt_circuit: synth::Circuit,
    pub opt_stats: synth::OptStats,
    pub vm_scratch: array::Array<u64>,
    pub vm_out: array::Array<u64>,

    // Live single-sentence inference readout
    pub last_fp: u64,
    pub last_teacher_probs: [4]f32,
    pub last_scratch_votes: [4]i32,
    pub last_kd_votes: [4]i32,
    pub last_teacher_pred: i32,
    pub last_scratch_pred: i32,
    pub last_kd_pred: i32,
}

pub fn (self: DistillLab) deinit(allocator: Allocator) -> void {
    self.train_fp.deinit(allocator);
    self.train_labels.deinit(allocator);
    self.val_fp.deinit(allocator);
    self.val_labels.deinit(allocator);
    self.unlab_fp.deinit(allocator);
    self.t_fc1.deinit(allocator);
    self.t_fc2.deinit(allocator);
    self.teacher_train_logits.deinit(allocator);
    self.teacher_val_preds.deinit(allocator);
    self.scratch.deinit(allocator);
    self.kd.deinit(allocator);
    self.x_buf.deinit(allocator);
    self.th_pre.deinit(allocator);
    self.th_act.deinit(allocator);
    self.t_logits.deinit(allocator);
    self.t_glogits.deinit(allocator);
    self.t_gh1.deinit(allocator);
    self.t_gh0.deinit(allocator);
    self.t_gx.deinit(allocator);
    self.s_a1.deinit(allocator);
    self.s_a2.deinit(allocator);
    self.s_a3.deinit(allocator);
    self.s_logits.deinit(allocator);
    self.s_glogits.deinit(allocator);
    self.s_ga3.deinit(allocator);
    self.s_ga2.deinit(allocator);
    self.s_ga1.deinit(allocator);
    self.s_gx.deinit(allocator);
    self.opt_circuit.deinit(allocator);
    self.vm_scratch.deinit(allocator);
    self.vm_out.deinit(allocator);
    return;
}

fn prealloc_dl_circuit(allocator: Allocator) -> mem::Error!synth::Circuit {
    let cap = dl_opt_cap();
    var ga = try core::alloc_i32(allocator, cap);
    errdefer ga.deinit(allocator);
    var gp = try core::alloc_i32(allocator, cap * 6);
    errdefer gp.deinit(allocator);
    var gt = try core::alloc_u64(allocator, cap);
    errdefer gt.deinit(allocator);
    var ow = try core::alloc_i32(allocator, dl_h3());
    errdefer ow.deinit(allocator);
    return synth::Circuit {
        input_width: dl_in_dim(),
        gate_count: 0,
        gate_arity: move ga,
        gate_pins: move gp,
        gate_tt: move gt,
        out_wires: move ow,
        group_sum_k: dl_num_classes(),
        group_sum_tau: 1.0,
    };
}

fn dl_zero_stats() -> synth::OptStats {
    return synth::OptStats {
        raw_gates: dl_total_gates(),
        opt_gates: dl_total_gates(),
        const_folded: 0,
        passthrough_removed: 0,
        inverted_absorbed: 0,
        cse_merged: 0,
        dce_removed: 0,
        raw_depth: 3,
        opt_depth: 3,
    };
}

pub fn dl_lab_new(allocator: Allocator, seed: u64) -> mem::Error!DistillLab {
    var rng = core::rng_new(seed);
    let max_b = dl_max_samples();
    let in_d = dl_in_dim();
    let th = dl_teacher_h();
    let k = dl_num_classes();

    var train_fp = try core::alloc_u64(allocator, max_b);
    errdefer train_fp.deinit(allocator);
    var train_labels = try core::alloc_i32(allocator, max_b);
    errdefer train_labels.deinit(allocator);
    var val_fp = try core::alloc_u64(allocator, max_b);
    errdefer val_fp.deinit(allocator);
    var val_labels = try core::alloc_i32(allocator, max_b);
    errdefer val_labels.deinit(allocator);
    var unlab_fp = try core::alloc_u64(allocator, max_b);
    errdefer unlab_fp.deinit(allocator);

    var t_fc1 = try model::linear_new(allocator, in_d, th, max_b, &var rng);
    errdefer t_fc1.deinit(allocator);
    var t_fc2 = try model::linear_new(allocator, th, k, max_b, &var rng);
    errdefer t_fc2.deinit(allocator);
    var teacher_train_logits = try core::alloc_f32(allocator, max_b * k);
    errdefer teacher_train_logits.deinit(allocator);
    var teacher_val_preds = try core::alloc_i32(allocator, max_b);
    errdefer teacher_val_preds.deinit(allocator);

    // Same seed so Scratch and KD students start from IDENTICAL random wiring & weights!
    var scratch = try student_new(allocator, seed + 1000);
    errdefer scratch.deinit(allocator);
    var kd = try student_new(allocator, seed + 1000);
    errdefer kd.deinit(allocator);

    var x_buf = try core::alloc_f32(allocator, max_b * in_d);
    errdefer x_buf.deinit(allocator);
    var th_pre = try core::alloc_f32(allocator, max_b * th);
    errdefer th_pre.deinit(allocator);
    var th_act = try core::alloc_f32(allocator, max_b * th);
    errdefer th_act.deinit(allocator);
    var t_logits = try core::alloc_f32(allocator, max_b * k);
    errdefer t_logits.deinit(allocator);
    var t_glogits = try core::alloc_f32(allocator, max_b * k);
    errdefer t_glogits.deinit(allocator);
    var t_gh1 = try core::alloc_f32(allocator, max_b * th);
    errdefer t_gh1.deinit(allocator);
    var t_gh0 = try core::alloc_f32(allocator, max_b * th);
    errdefer t_gh0.deinit(allocator);
    var t_gx = try core::alloc_f32(allocator, max_b * in_d);
    errdefer t_gx.deinit(allocator);

    var s_a1 = try core::alloc_f32(allocator, max_b * dl_h1());
    errdefer s_a1.deinit(allocator);
    var s_a2 = try core::alloc_f32(allocator, max_b * dl_h2());
    errdefer s_a2.deinit(allocator);
    var s_a3 = try core::alloc_f32(allocator, max_b * dl_h3());
    errdefer s_a3.deinit(allocator);
    var s_logits = try core::alloc_f32(allocator, max_b * k);
    errdefer s_logits.deinit(allocator);
    var s_glogits = try core::alloc_f32(allocator, max_b * k);
    errdefer s_glogits.deinit(allocator);
    var s_ga3 = try core::alloc_f32(allocator, max_b * dl_h3());
    errdefer s_ga3.deinit(allocator);
    var s_ga2 = try core::alloc_f32(allocator, max_b * dl_h2());
    errdefer s_ga2.deinit(allocator);
    var s_ga1 = try core::alloc_f32(allocator, max_b * dl_h1());
    errdefer s_ga1.deinit(allocator);
    var s_gx = try core::alloc_f32(allocator, max_b * in_d);
    errdefer s_gx.deinit(allocator);

    var opt_c = try prealloc_dl_circuit(allocator);
    errdefer opt_c.deinit(allocator);
    var vm_scratch = try core::alloc_u64(allocator, in_d + dl_opt_cap());
    errdefer vm_scratch.deinit(allocator);
    var vm_out = try core::alloc_u64(allocator, dl_h3());
    errdefer vm_out.deinit(allocator);

    return DistillLab {
        rng: rng,
        teacher_step: 0,
        student_step: 0,
        train_count: 0,
        train_fp: move train_fp,
        train_labels: move train_labels,
        val_count: 0,
        val_fp: move val_fp,
        val_labels: move val_labels,
        unlab_count: 0,
        unlab_fp: move unlab_fp,
        t_fc1: move t_fc1,
        t_fc2: move t_fc2,
        teacher_train_logits: move teacher_train_logits,
        teacher_val_preds: move teacher_val_preds,
        scratch: move scratch,
        kd: move kd,
        x_buf: move x_buf,
        th_pre: move th_pre,
        th_act: move th_act,
        t_logits: move t_logits,
        t_glogits: move t_glogits,
        t_gh1: move t_gh1,
        t_gh0: move t_gh0,
        t_gx: move t_gx,
        s_a1: move s_a1,
        s_a2: move s_a2,
        s_a3: move s_a3,
        s_logits: move s_logits,
        s_glogits: move s_glogits,
        s_ga3: move s_ga3,
        s_ga2: move s_ga2,
        s_ga1: move s_ga1,
        s_gx: move s_gx,
        teacher_train_acc: 0.25,
        teacher_val_acc: 0.25,
        scratch_loss: 1.386,
        scratch_train_acc: 0.25,
        scratch_val_acc: 0.25,
        kd_loss: 1.386,
        kd_train_acc: 0.25,
        kd_val_acc: 0.25,
        kd_teacher_agree: 0.25,
        has_synth: false,
        opt_circuit: move opt_c,
        opt_stats: dl_zero_stats(),
        vm_scratch: move vm_scratch,
        vm_out: move vm_out,
        last_fp: 0,
        last_teacher_probs: [4]f32{ 0.25, 0.25, 0.25, 0.25 },
        last_scratch_votes: [4]i32{ 0, 0, 0, 0 },
        last_kd_votes: [4]i32{ 0, 0, 0, 0 },
        last_teacher_pred: 0,
        last_scratch_pred: 0,
        last_kd_pred: 0,
    };
}

pub fn dl_lab_clear(lab: &var DistillLab) -> void {
    lab.train_count = 0;
    lab.val_count = 0;
    lab.unlab_count = 0;
    return;
}

/// split: 0 = labeled train, 1 = held-out val, 2 = unlabeled Japanese stream (KD Teacher only)
pub fn dl_lab_add_text(lab: &var DistillLab, text: []u8, label: i32, split: i32) -> i64 {
    let fp = jp_encode_utf8_64(text);
    if split == 1 {
        if lab.val_count >= dl_max_samples() { return lab.val_count; }
        let idx = lab.val_count;
        let vfp = lab.val_fp.as_mut_slice();
        let vlb = lab.val_labels.as_mut_slice();
        vfp[idx] = fp;
        vlb[idx] = label;
        lab.val_count = idx + 1;
        return lab.val_count;
    }
    if split == 2 {
        if lab.train_count + lab.unlab_count >= dl_max_samples() { return lab.unlab_count; }
        let idx = lab.unlab_count;
        let ufp = lab.unlab_fp.as_mut_slice();
        ufp[idx] = fp;
        lab.unlab_count = idx + 1;
        return lab.unlab_count;
    }
    if lab.train_count + lab.unlab_count >= dl_max_samples() { return lab.train_count; }
    let idx = lab.train_count;
    let tfp = lab.train_fp.as_mut_slice();
    let tlb = lab.train_labels.as_mut_slice();
    tfp[idx] = fp;
    tlb[idx] = label;
    lab.train_count = idx + 1;
    return lab.train_count;
}

fn fill_x_from_fp_slice(fps: []u64, n: i64, row_off: i64, x_out: &var []f32) -> void {
    for 0..n |b| {
        let mask = fps[b];
        let off = (row_off + b) * 64;
        for 0..64 |i| {
            let bit = (mask >> cast<u64>(i)) & cast<u64>(1);
            x_out[off + i] = if bit != 0 { cast<f32>(1.0) } else { cast<f32>(0.0) };
        }
    }
    return;
}

fn fill_x_train(lab: &var DistillLab) -> void {
    let fps = lab.train_fp.as_slice();
    let xb = lab.x_buf.as_mut_slice();
    fill_x_from_fp_slice(fps, lab.train_count, 0, xb);
    return;
}

fn fill_x_kd(lab: &var DistillLab) -> i64 {
    let n = lab.train_count;
    let u = lab.unlab_count;
    let tfps = lab.train_fp.as_slice();
    let ufps = lab.unlab_fp.as_slice();
    let xb = lab.x_buf.as_mut_slice();
    fill_x_from_fp_slice(tfps, n, 0, xb);
    if u > 0 {
        fill_x_from_fp_slice(ufps, u, n, xb);
    }
    return n + u;
}

fn fill_x_val(lab: &var DistillLab) -> void {
    let fps = lab.val_fp.as_slice();
    let xb = lab.x_buf.as_mut_slice();
    fill_x_from_fp_slice(fps, lab.val_count, 0, xb);
    return;
}

fn dl_teacher_fwd(lab: &var DistillLab, n: i64) -> void {
    let xs = lab.x_buf.as_slice();
    let h_pre = lab.th_pre.as_mut_slice();
    model::linear_forward(&var lab.t_fc1, xs, n, h_pre);
    let h_pre_s = lab.th_pre.as_slice();
    let h_act = lab.th_act.as_mut_slice();
    model::gelu_forward(h_pre_s, h_act, n * dl_teacher_h());
    let h_act_s = lab.th_act.as_slice();
    let lg = lab.t_logits.as_mut_slice();
    model::linear_forward(&var lab.t_fc2, h_act_s, n, lg);
    return;
}

fn dl_teacher_bwd_step(lab: &var DistillLab, n: i64, lr: f32) -> f32 {
    let lg = lab.t_logits.as_slice();
    let y = lab.train_labels.as_slice();
    let glg = lab.t_glogits.as_mut_slice();
    let loss = lut::cross_entropy_loss_grad(lg, y, n, dl_num_classes(), glg);

    model::linear_zero_grad(&var lab.t_fc1);
    model::linear_zero_grad(&var lab.t_fc2);

    let glg_s = lab.t_glogits.as_slice();
    let gh1 = lab.t_gh1.as_mut_slice();
    model::linear_backward(&var lab.t_fc2, glg_s, gh1, true);

    let h_pre_s = lab.th_pre.as_slice();
    let gh1_s = lab.t_gh1.as_slice();
    let gh0 = lab.t_gh0.as_mut_slice();
    model::gelu_backward(h_pre_s, gh1_s, gh0, n * dl_teacher_h());

    let gh0_s = lab.t_gh0.as_slice();
    let gx = lab.t_gx.as_mut_slice();
    model::linear_backward(&var lab.t_fc1, gh0_s, gx, false);

    lab.teacher_step = lab.teacher_step + 1;
    model::linear_adamw_step(&var lab.t_fc1, lr, 0.05, lab.teacher_step);
    model::linear_adamw_step(&var lab.t_fc2, lr, 0.05, lab.teacher_step);
    return loss;
}

fn dl_acc_from_logits(logits: []f32, labels: []i32, n: i64) -> f32 {
    if n <= 0 { return 0.0; }
    let k = dl_num_classes();
    var ok: i64 = 0;
    for 0..n |b| {
        let off = b * k;
        var best: i64 = 0;
        var best_v = logits[off];
        for 1..k |c| {
            if logits[off + c] > best_v {
                best_v = logits[off + c];
                best = c;
            }
        }
        if best == cast<i64>(labels[b]) { ok = ok + 1; }
    }
    return cast<f32>(cast<f64>(ok) / cast<f64>(n));
}

fn cache_teacher_outputs(lab: &var DistillLab) -> void {
    let n = lab.train_count;
    let kd_n = fill_x_kd(lab);
    let k = dl_num_classes();
    if kd_n > 0 {
        dl_teacher_fwd(lab, kd_n);
        let src = lab.t_logits.as_slice();
        let dst = lab.teacher_train_logits.as_mut_slice();
        for 0..(kd_n * k) |i| { dst[i] = src[i]; }
        if n > 0 {
            let y = lab.train_labels.as_slice();
            lab.teacher_train_acc = dl_acc_from_logits(src, y, n);
        }
    }
    let vn = lab.val_count;
    if vn > 0 {
        fill_x_val(lab);
        dl_teacher_fwd(lab, vn);
        let src = lab.t_logits.as_slice();
        let vy = lab.val_labels.as_slice();
        let vp = lab.teacher_val_preds.as_mut_slice();
        lab.teacher_val_acc = dl_acc_from_logits(src, vy, vn);
        for 0..vn |b| {
            let off = b * k;
            var best: i64 = 0;
            var best_v = src[off];
            for 1..k |c| {
                if src[off + c] > best_v {
                    best_v = src[off + c];
                    best = c;
                }
            }
            vp[b] = cast<i32>(best);
        }
    }
    return;
}

pub fn dl_lab_train_teacher(lab: &var DistillLab, steps: i64, lr: f32) -> f32 {
    let n = lab.train_count;
    if n <= 0 { return 1.386; }
    fill_x_train(lab);
    var last_loss: f32 = 1.386;
    for 0..steps |_| {
        dl_teacher_fwd(lab, n);
        last_loss = dl_teacher_bwd_step(lab, n, lr);
    }
    cache_teacher_outputs(lab);
    return last_loss;
}

fn student_fwd_into_bufs(
    net: &var StudentNet,
    x_s: []f32,
    n: i64,
    a1: &var array::Array<f32>,
    a2: &var array::Array<f32>,
    a3: &var array::Array<f32>,
    lg: &var array::Array<f32>,
    training: bool,
    force_soft: bool,
    rng: &var core::Rng
) -> void {
    let s1 = net.l1.select_mode;
    let s2 = net.l2.select_mode;
    let s3 = net.l3.select_mode;
    if force_soft {
        net.l1.select_mode = lut::SelectMode::Soft;
        net.l2.select_mode = lut::SelectMode::Soft;
        net.l3.select_mode = lut::SelectMode::Soft;
    }
    let a1_m = a1.as_mut_slice();
    lut::lut_forward(&var net.l1, x_s, n, a1_m, training, rng);
    let a1_s = a1.as_slice();
    let a2_m = a2.as_mut_slice();
    lut::lut_forward(&var net.l2, a1_s, n, a2_m, training, rng);
    let a2_s = a2.as_slice();
    let a3_m = a3.as_mut_slice();
    lut::lut_forward(&var net.l3, a2_s, n, a3_m, training, rng);
    let a3_s = a3.as_slice();
    let lg_m = lg.as_mut_slice();
    lut::groupsum_forward(&net.gs, a3_s, n, lg_m);
    if force_soft {
        net.l1.select_mode = s1;
        net.l2.select_mode = s2;
        net.l3.select_mode = s3;
    }
    return;
}

fn student_bwd_and_step(
    net: &var StudentNet,
    n: i64,
    glg_s: []f32,
    ga3: &var array::Array<f32>,
    ga2: &var array::Array<f32>,
    ga1: &var array::Array<f32>,
    gx: &var array::Array<f32>,
    lr: f32,
    step: i64
) -> void {
    lut::lut_zero_grad(&var net.l1);
    lut::lut_zero_grad(&var net.l2);
    lut::lut_zero_grad(&var net.l3);

    let ga3_m = ga3.as_mut_slice();
    lut::groupsum_backward(&net.gs, glg_s, n, ga3_m);
    let ga3_s = ga3.as_slice();
    let ga2_m = ga2.as_mut_slice();
    lut::lut_backward(&var net.l3, ga3_s, ga2_m, true);
    let ga2_s = ga2.as_slice();
    let ga1_m = ga1.as_mut_slice();
    lut::lut_backward(&var net.l2, ga2_s, ga1_m, true);
    let ga1_s = ga1.as_slice();
    let gx_m = gx.as_mut_slice();
    lut::lut_backward(&var net.l1, ga1_s, gx_m, false);

    lut::lut_adamw_step(&var net.l1, lr, 0.9, 0.999, 1e-8, 0.0, step);
    lut::lut_adamw_step(&var net.l2, lr, 0.9, 0.999, 1e-8, 0.0, step);
    lut::lut_adamw_step(&var net.l3, lr, 0.9, 0.999, 1e-8, 0.0, step);
    return;
}

/// Semi-supervised KL distillation gradient:
/// - Rows [0..labeled_n): (1 - alpha) * CE(student, y) + alpha * T^2 * KL(teacher/T || student/T)
/// - Rows [labeled_n..total_n): pure T^2 * KL(teacher/T || student/T) on unlabeled Japanese logs!
fn kd_semisup_loss_grad(
    student_logits: []f32,
    teacher_logits: []f32,
    targets: []i32,
    labeled_n: i64,
    total_n: i64,
    k: i64,
    alpha: f32,
    kd_temp: f32,
    grad_out: &var []f32
) -> f32 {
    let inv_total = 1.0 / cast<f64>(total_n);
    let a = cast<f64>(alpha);
    let t = cast<f64>(kd_temp);
    let inv_t = 1.0 / t;
    var total_loss: f64 = 0.0;
    var ps = [8]f64{};
    var pst = [8]f64{};
    var ptt = [8]f64{};

    for 0..total_n |b| {
        let off = b * k;
        var max_s = cast<f64>(student_logits[off]);
        var max_st = max_s * inv_t;
        var max_tt = cast<f64>(teacher_logits[off]) * inv_t;
        for 1..k |c| {
            let s = cast<f64>(student_logits[off + c]);
            let st = s * inv_t;
            let tt = cast<f64>(teacher_logits[off + c]) * inv_t;
            if s > max_s { max_s = s; }
            if st > max_st { max_st = st; }
            if tt > max_tt { max_tt = tt; }
        }
        var sum_s: f64 = 0.0;
        var sum_st: f64 = 0.0;
        var sum_tt: f64 = 0.0;
        for 0..k |c| {
            let es = math::exp<f64>(cast<f64>(student_logits[off + c]) - max_s);
            let est = math::exp<f64>(cast<f64>(student_logits[off + c]) * inv_t - max_st);
            let ett = math::exp<f64>(cast<f64>(teacher_logits[off + c]) * inv_t - max_tt);
            ps[c] = es;
            pst[c] = est;
            ptt[c] = ett;
            sum_s = sum_s + es;
            sum_st = sum_st + est;
            sum_tt = sum_tt + ett;
        }
        let inv_s = 1.0 / sum_s;
        let inv_st = 1.0 / sum_st;
        let inv_tt = 1.0 / sum_tt;
        if b < labeled_n {
            let y = cast<i64>(targets[b]);
            total_loss = total_loss + (max_s + math::log<f64>(sum_s) - cast<f64>(student_logits[off + y]));
            for 0..k |c| {
                var ce_g = ps[c] * inv_s;
                if c == y { ce_g = ce_g - 1.0; }
                let kd_g = (pst[c] * inv_st - ptt[c] * inv_tt) * t;
                grad_out[off + c] = cast<f32>(((1.0 - a) * ce_g + a * kd_g) * inv_total);
            }
        } else {
            // Unlabeled Japanese utterance: pure Teacher soft-target KL gradient
            for 0..k |c| {
                let kd_g = (pst[c] * inv_st - ptt[c] * inv_tt) * t;
                grad_out[off + c] = cast<f32>(kd_g * inv_total);
            }
        }
    }
    if labeled_n > 0 {
        return cast<f32>(total_loss / cast<f64>(labeled_n));
    }
    return 0.0;
}

fn set_student_schedule(net: &var StudentNet, use_gst: bool, tau: f32, gs_noise: f32) -> void {
    let mode = if use_gst { lut::SelectMode::GumbelSt } else { lut::SelectMode::Soft };
    net.l1.select_mode = mode;
    net.l2.select_mode = mode;
    net.l3.select_mode = mode;
    net.l1.tau = tau;
    net.l2.tau = tau;
    net.l3.tau = tau;
    net.l1.gumbel_scale = gs_noise;
    net.l2.gumbel_scale = gs_noise;
    net.l3.gumbel_scale = gs_noise;
    return;
}

fn step_one_student(lab: &var DistillLab, is_kd: bool, use_gst: bool, lr: f32, tau: f32, gs_noise: f32) -> f32 {
    let n = lab.train_count;
    let kd_n = n + lab.unlab_count;
    let k = dl_num_classes();
    let xs = lab.x_buf.as_slice();

    if is_kd {
        set_student_schedule(&var lab.kd, use_gst, tau, gs_noise);
        student_fwd_into_bufs(&var lab.kd, xs, kd_n, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, true, false, &var lab.rng);
        let lg_s = lab.s_logits.as_slice();
        let tlg_s = lab.teacher_train_logits.as_slice();
        let y_s = lab.train_labels.as_slice();
        let glg_m = lab.s_glogits.as_mut_slice();
        let loss = kd_semisup_loss_grad(lg_s, tlg_s, y_s, n, kd_n, k, 0.70, 2.0, glg_m);
        let glg_s = lab.s_glogits.as_slice();
        student_bwd_and_step(&var lab.kd, kd_n, glg_s, &var lab.s_ga3, &var lab.s_ga2, &var lab.s_ga1, &var lab.s_gx, lr, lab.student_step);
        return loss;
    }

    set_student_schedule(&var lab.scratch, use_gst, tau, gs_noise);
    student_fwd_into_bufs(&var lab.scratch, xs, n, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, true, false, &var lab.rng);
    let lg_s = lab.s_logits.as_slice();
    let y_s = lab.train_labels.as_slice();
    let glg_m = lab.s_glogits.as_mut_slice();
    let loss = lut::cross_entropy_loss_grad(lg_s, y_s, n, k, glg_m);
    let glg_s = lab.s_glogits.as_slice();
    student_bwd_and_step(&var lab.scratch, n, glg_s, &var lab.s_ga3, &var lab.s_ga2, &var lab.s_ga1, &var lab.s_gx, lr, lab.student_step);
    return loss;
}

pub fn dl_lab_eval_students(lab: &var DistillLab) -> void {
    let n = lab.train_count;
    let vn = lab.val_count;
    let k = dl_num_classes();

    if n > 0 {
        fill_x_train(lab);
        let xs = lab.x_buf.as_slice();
        let y = lab.train_labels.as_slice();
        let glg = lab.s_glogits.as_mut_slice();

        // Scratch soft loss + hard acc
        student_fwd_into_bufs(&var lab.scratch, xs, n, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, true, true, &var lab.rng);
        let slg_s = lab.s_logits.as_slice();
        lab.scratch_loss = lut::cross_entropy_loss_grad(slg_s, y, n, k, glg);
        student_fwd_into_bufs(&var lab.scratch, xs, n, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, false, false, &var lab.rng);
        let slg_h = lab.s_logits.as_slice();
        lab.scratch_train_acc = dl_acc_from_logits(slg_h, y, n);

        // KD soft loss + hard acc
        student_fwd_into_bufs(&var lab.kd, xs, n, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, true, true, &var lab.rng);
        let klg_s = lab.s_logits.as_slice();
        lab.kd_loss = lut::cross_entropy_loss_grad(klg_s, y, n, k, glg);
        student_fwd_into_bufs(&var lab.kd, xs, n, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, false, false, &var lab.rng);
        let klg_h = lab.s_logits.as_slice();
        lab.kd_train_acc = dl_acc_from_logits(klg_h, y, n);
    }

    if vn > 0 {
        fill_x_val(lab);
        let xs = lab.x_buf.as_slice();
        let vy = lab.val_labels.as_slice();
        let tp = lab.teacher_val_preds.as_slice();

        student_fwd_into_bufs(&var lab.scratch, xs, vn, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, false, false, &var lab.rng);
        let slg = lab.s_logits.as_slice();
        lab.scratch_val_acc = dl_acc_from_logits(slg, vy, vn);

        student_fwd_into_bufs(&var lab.kd, xs, vn, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, false, false, &var lab.rng);
        let klg = lab.s_logits.as_slice();
        lab.kd_val_acc = dl_acc_from_logits(klg, vy, vn);
        lab.kd_teacher_agree = dl_acc_from_logits(klg, tp, vn);
    }
    return;
}

pub fn dl_lab_train_students(lab: &var DistillLab, steps: i64, lr: f32) -> i64 {
    if lab.train_count <= 0 or steps <= 0 {
        dl_lab_eval_students(lab);
        return lab.student_step;
    }
    let _ = fill_x_kd(lab);
    for 0..steps |_| {
        lab.student_step = lab.student_step + 1;
        var prog = cast<f64>(lab.student_step) / 240.0;
        if prog > 1.0 { prog = 1.0; }
        let use_gst = lab.student_step > 155;
        let tau = cast<f32>(1.0 - 0.72 * prog);
        let gs_noise = if use_gst { cast<f32>(0.22 * (1.0 - 0.85 * ((prog - 0.64) / 0.36))) } else { cast<f32>(0.0) };
        let _ = step_one_student(lab, false, use_gst, lr, tau, gs_noise);
        let _ = step_one_student(lab, true, use_gst, lr, tau, gs_noise);
    }
    lab.has_synth = false;
    dl_lab_eval_students(lab);
    return lab.student_step;
}

pub fn dl_lab_synthesize(allocator: Allocator, lab: &var DistillLab) -> mem::Error!i64 {
    var d1 = try lut::lut_discretize(allocator, &lab.kd.l1);
    defer d1.deinit(allocator);
    var d2 = try lut::lut_discretize(allocator, &lab.kd.l2);
    defer d2.deinit(allocator);
    var d3 = try lut::lut_discretize(allocator, &lab.kd.l3);
    defer d3.deinit(allocator);

    var raw_c = try synth::circuit_from_discrete_triple(allocator, &d1, &d2, &d3, dl_num_classes(), 1.0);
    defer raw_c.deinit(allocator);
    var opt = try synth::circuit_optimize(allocator, &raw_c);
    defer opt.deinit(allocator);

    // Copy into fixed-capacity opt_circuit in place
    let g = opt.circuit.gate_count;
    let oc = opt.circuit.out_wires.len();
    let ga_d = lab.opt_circuit.gate_arity.as_mut_slice();
    let gp_d = lab.opt_circuit.gate_pins.as_mut_slice();
    let gt_d = lab.opt_circuit.gate_tt.as_mut_slice();
    let ow_d = lab.opt_circuit.out_wires.as_mut_slice();
    let ga_s = opt.circuit.gate_arity.as_slice();
    let gp_s = opt.circuit.gate_pins.as_slice();
    let gt_s = opt.circuit.gate_tt.as_slice();
    let ow_s = opt.circuit.out_wires.as_slice();
    for 0..g |i| {
        ga_d[i] = ga_s[i];
        gt_d[i] = gt_s[i];
        for 0..6 |p| { gp_d[i * 6 + p] = gp_s[i * 6 + p]; }
    }
    for 0..oc |i| { ow_d[i] = ow_s[i]; }
    lab.opt_circuit.gate_count = g;
    lab.opt_stats = opt.stats;
    lab.has_synth = true;
    return opt.stats.opt_gates;
}

pub fn dl_lab_emit_code(allocator: Allocator, lab: &DistillLab, out: &var string::String) -> mem::Error!void {
    try codegen::emit_aot_kizu_fn(allocator, &lab.opt_circuit, "aot_jp_router_64", out);
    return;
}

fn fill_single_fp(lab: &var DistillLab, fp: u64) -> void {
    let xb = lab.x_buf.as_mut_slice();
    for 0..64 |i| {
        let bit = (fp >> cast<u64>(i)) & cast<u64>(1);
        xb[i] = if bit != 0 { cast<f32>(1.0) } else { cast<f32>(0.0) };
    }
    return;
}

fn run_dl_vm_single(lab: &var DistillLab, fp: u64) -> i32 {
    var in_bits = [64]u64{};
    let ib = in_bits.as_mut_slice();
    for 0..64 |i| {
        let bit = (fp >> cast<u64>(i)) & cast<u64>(1);
        ib[i] = if bit != 0 { cast<u64>(1) } else { cast<u64>(0) };
    }
    let ib_s = in_bits.as_slice();
    let sc = lab.vm_scratch.as_mut_slice();
    let ob = lab.vm_out.as_mut_slice();
    synth::eval_circuit_vm_u64(&lab.opt_circuit, ib_s, sc, ob);
    let ob_s = lab.vm_out.as_slice();
    var best: i32 = 0;
    var best_v: i32 = -1;
    for 0..4 |c| {
        var votes: i32 = 0;
        for 0..8 |j| {
            if (ob_s[c * 8 + j] & cast<u64>(1)) != 0 { votes = votes + 1; }
        }
        lab.last_kd_votes[c] = votes;
        if votes > best_v {
            best_v = votes;
            best = cast<i32>(c);
        }
    }
    return best;
}

fn infer_teacher_stage(lab: &var DistillLab) -> void {
    dl_teacher_fwd(lab, 1);
    let tlg = lab.t_logits.as_slice();
    var max_v = cast<f64>(tlg[0]);
    for 1..4 |c| { if cast<f64>(tlg[c]) > max_v { max_v = cast<f64>(tlg[c]); } }
    var sum_e: f64 = 0.0;
    var exps = [4]f64{};
    for 0..4 |c| {
        let e = math::exp<f64>(cast<f64>(tlg[c]) - max_v);
        exps[c] = e;
        sum_e = sum_e + e;
    }
    var t_best: i32 = 0;
    var t_best_p: f32 = -1.0;
    for 0..4 |c| {
        let p = cast<f32>(exps[c] / sum_e);
        lab.last_teacher_probs[c] = p;
        if p > t_best_p { t_best_p = p; t_best = cast<i32>(c); }
    }
    lab.last_teacher_pred = t_best;
    return;
}

fn infer_scratch_stage(lab: &var DistillLab) -> void {
    let xs = lab.x_buf.as_slice();
    student_fwd_into_bufs(&var lab.scratch, xs, 1, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, false, false, &var lab.rng);
    let sa3 = lab.s_a3.as_slice();
    var s_best: i32 = 0;
    var s_best_v: i32 = -1;
    for 0..4 |c| {
        var votes: i32 = 0;
        for 0..8 |j| { if sa3[c * 8 + j] >= 0.5 { votes = votes + 1; } }
        lab.last_scratch_votes[c] = votes;
        if votes > s_best_v { s_best_v = votes; s_best = cast<i32>(c); }
    }
    lab.last_scratch_pred = s_best;
    return;
}

fn infer_kd_lut_stage(lab: &var DistillLab) -> void {
    let xs = lab.x_buf.as_slice();
    student_fwd_into_bufs(&var lab.kd, xs, 1, &var lab.s_a1, &var lab.s_a2, &var lab.s_a3, &var lab.s_logits, false, false, &var lab.rng);
    let ka3 = lab.s_a3.as_slice();
    var k_best: i32 = 0;
    var k_best_v: i32 = -1;
    for 0..4 |c| {
        var votes: i32 = 0;
        for 0..8 |j| { if ka3[c * 8 + j] >= 0.5 { votes = votes + 1; } }
        lab.last_kd_votes[c] = votes;
        if votes > k_best_v { k_best_v = votes; k_best = cast<i32>(c); }
    }
    lab.last_kd_pred = k_best;
    return;
}

pub fn dl_lab_infer_utf8(lab: &var DistillLab, text: []u8) -> i32 {
    let fp = jp_encode_utf8_64(text);
    lab.last_fp = fp;
    fill_single_fp(lab, fp);
    infer_teacher_stage(lab);
    infer_scratch_stage(lab);
    if lab.has_synth {
        lab.last_kd_pred = run_dl_vm_single(lab, fp);
    } else {
        infer_kd_lut_stage(lab);
    }
    return lab.last_kd_pred;
}

pub fn dl_lab_bench(lab: &var DistillLab, is_vm: bool, iters: i64) -> i32 {
    if is_vm {
        if !lab.has_synth { return 0; }
        var in_bits = [64]u64{};
        let ib = in_bits.as_mut_slice();
        for 0..64 |i| { ib[i] = cast<u64>(0x55555555) ^ (cast<u64>(i) << 2); }
        let sc = lab.vm_scratch.as_mut_slice();
        let ob = lab.vm_out.as_mut_slice();
        var sink: u64 = 0;
        for 0..iters |step| {
            ib[0] = cast<u64>(step);
            synth::eval_circuit_vm_u64(&lab.opt_circuit, ib, sc, ob);
            sink = sink ^ ob[0] ^ ob[8] ^ ob[16] ^ ob[24];
        }
        return cast<i32>(sink & cast<u64>(0x7fffffff));
    }
    let fp = lab.last_fp;
    fill_single_fp(lab, fp);
    var acc: f32 = 0.0;
    for 0..iters |_| {
        dl_teacher_fwd(lab, 1);
        let tlg = lab.t_logits.as_slice();
        acc = acc + tlg[0];
    }
    return cast<i32>(acc * 100.0);
}

test "distill lab Japanese router trains Teacher + KD Student + synthesizes with 0 VM mismatch" {
    let allocator = mem::page_allocator();
    var lab = try dl_lab_new(allocator, 7);
    defer lab.deinit(allocator);

    // 4 Japanese classes: 0=質問, 1=依頼, 2=称賛, 3=不満
    let _ = dl_lab_add_text(&var lab, "これどうやって使うんですか？", 0, 0);
    let _ = dl_lab_add_text(&var lab, "なぜ論理ゲートで動くのですか？", 0, 0);
    let _ = dl_lab_add_text(&var lab, "料金プランの違いを教えて？", 0, 0);
    let _ = dl_lab_add_text(&var lab, "設定はどこにありますか？", 0, 0);

    let _ = dl_lab_add_text(&var lab, "この画面のデザインを直して", 1, 0);
    let _ = dl_lab_add_text(&var lab, "明日までに資料をまとめてお願い", 1, 0);
    let _ = dl_lab_add_text(&var lab, "新しいデモページを作ってほしい", 1, 0);
    let _ = dl_lab_add_text(&var lab, "日本語の要約をお願いします", 1, 0);

    let _ = dl_lab_add_text(&var lab, "めちゃくちゃ速くて最高！ありがとう", 2, 0);
    let _ = dl_lab_add_text(&var lab, "すごくわかりやすい！助かりました", 2, 0);
    let _ = dl_lab_add_text(&var lab, "素晴らしいデザインですね！感動", 2, 0);
    let _ = dl_lab_add_text(&var lab, "とても綺麗に動いて嬉しい！", 2, 0);

    let _ = dl_lab_add_text(&var lab, "エラーが出て全く動かない", 3, 0);
    let _ = dl_lab_add_text(&var lab, "重すぎてフリーズして困った", 3, 0);
    let _ = dl_lab_add_text(&var lab, "バグで保存できず最悪です", 3, 0);
    let _ = dl_lab_add_text(&var lab, "読み込みが遅くて失敗する", 3, 0);

    // Unlabeled Japanese stream (label ignored; Teacher annotates)
    let _ = dl_lab_add_text(&var lab, "どこから始めればいいですか？", -1, 2);
    let _ = dl_lab_add_text(&var lab, "グラフを追加してくださいお願い", -1, 2);
    let _ = dl_lab_add_text(&var lab, "軽くて快適！本当にありがとう！", -1, 2);
    let _ = dl_lab_add_text(&var lab, "クラッシュして動かない不具合", -1, 2);

    // Held-out val
    let _ = dl_lab_add_text(&var lab, "どうやって動いているの？", 0, 1);
    let _ = dl_lab_add_text(&var lab, "ここを直してほしいお願い", 1, 1);
    let _ = dl_lab_add_text(&var lab, "すごく速くてありがとう！", 2, 1);
    let _ = dl_lab_add_text(&var lab, "エラーで動かない困った", 3, 1);

    let _ = dl_lab_train_teacher(&var lab, 80, 0.03);
    testing::expect(lab.teacher_train_acc >= 0.99);

    let _ = dl_lab_train_students(&var lab, 200, 0.08);
    testing::expect(lab.kd_train_acc >= 0.99);

    let pre0 = dl_lab_infer_utf8(&var lab, "どうやって動いているの？");
    let pre3 = dl_lab_infer_utf8(&var lab, "エラーで動かない困った");
    let opt_g = try dl_lab_synthesize(allocator, &var lab);
    testing::expect(opt_g < dl_total_gates());
    testing::expect(dl_lab_infer_utf8(&var lab, "どうやって動いているの？") == pre0);
    testing::expect(dl_lab_infer_utf8(&var lab, "エラーで動かない困った") == pre3);

    var code = string::new(allocator);
    defer code.deinit(allocator);
    try dl_lab_emit_code(allocator, &lab, &var code);
    testing::expect(code.len() > 80);
}
