    if which == 3 { return cast<i32>(t.opt_stats.opt_depth); }
    if which == 4 { return cast<i32>(t.opt_stats.const_folded); }
    if which == 5 { return cast<i32>(t.opt_stats.passthrough_removed); }
    if which == 6 { return cast<i32>(t.opt_stats.inverted_absorbed); }
    if which == 7 { return cast<i32>(t.opt_stats.cse_merged); }
    if which == 8 { return cast<i32>(t.opt_stats.dce_removed); }
    return 0;
}

fn emit_artifacts_inner(allocator: Allocator, t: &LiveTrainer) -> mem::Error!void {
    var code = string::new(allocator);
    defer code.deinit(allocator);
    try trainer_emit_aot_code(allocator, t, &var code);
    let code_bytes = code.as_bytes();
    // SAFETY: give_bytes synchronously copies code_bytes inside JS host.
    unsafe give_bytes(0, code_bytes);

    var ir = string::new(allocator);
    defer ir.deinit(allocator);
    try trainer_emit_ir_json(allocator, t, &var ir);
    let ir_bytes = ir.as_bytes();
    // SAFETY: give_bytes synchronously copies ir_bytes inside JS host.
    unsafe give_bytes(1, ir_bytes);
    return;
}

export "browser" fn live_emit_artifacts(handle: usize) -> i32 {
    if handle == 0 { return 1; }
    let allocator = mem::page_allocator();
    // SAFETY: handle came from live_create and stays valid for this Wasm instance.
    let p = unsafe ptr_from_int<ptr<LiveTrainer>>(handle);
    // SAFETY: single-threaded browser Wasm read access.
    let t = unsafe &p.*;
    if !t.has_synth { return 2; }
    if emit_artifacts_inner(allocator, t) {} else |_| {
        return 3;
    }
    return 0;
}

