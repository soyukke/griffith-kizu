export "browser" fn distill_synth_stat(handle: usize, which: i32) -> i32 {
    if handle == 0 { return 0; }
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let lab = unsafe &p.*;
    if which == 0 { return cast<i32>(lab.opt_stats.raw_gates); }
    if which == 1 { return cast<i32>(lab.opt_stats.opt_gates); }
    if which == 2 { return cast<i32>(lab.opt_stats.raw_depth); }
    if which == 3 { return cast<i32>(lab.opt_stats.opt_depth); }
    if which == 4 { return cast<i32>(lab.opt_stats.const_folded); }
    if which == 5 { return cast<i32>(lab.opt_stats.passthrough_removed); }
    if which == 6 { return cast<i32>(lab.opt_stats.inverted_absorbed); }
    if which == 7 { return cast<i32>(lab.opt_stats.cse_merged); }
    if which == 8 { return cast<i32>(lab.opt_stats.dce_removed); }
    return 0;
}

fn emit_distill_code_inner(allocator: Allocator, lab: &DistillLab) -> mem::Error!void {
    var code = string::new(allocator);
    defer code.deinit(allocator);
    try dl_lab_emit_code(allocator, lab, &var code);
    let bytes = code.as_bytes();
    // SAFETY: give_bytes synchronously copies bytes inside JS host.
    unsafe give_bytes(0, bytes);
    return;
}

export "browser" fn distill_emit_code(handle: usize) -> i32 {
    if handle == 0 { return 1; }
    let allocator = mem::page_allocator();
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let lab = unsafe &p.*;
    if !lab.has_synth { return 2; }
    if emit_distill_code_inner(allocator, lab) {} else |_| { return 3; }
    return 0;
}

fn distill_infer_slot_inner(allocator: Allocator, lab: &var DistillLab, byte_len: i64) -> mem::Error!i32 {
    var text = try read_host_slot(allocator, 1, byte_len);
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    return dl_lab_infer_utf8(lab, bytes);
}

export "browser" fn distill_infer(handle: usize, byte_len: i32) -> i32 {
    if handle == 0 { return -1; }
    let allocator = mem::page_allocator();
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm exclusive access.
    let lab = unsafe &var p.*;
    return distill_infer_slot_inner(allocator, lab, cast<i64>(byte_len)) catch -1;
}

export "browser" fn distill_result(handle: usize, which: i32, cls: i32) -> i32 {
    if handle == 0 or cls < 0 or cls >= 4 { return 0; }
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let lab = unsafe &p.*;
    let c = cast<i64>(cls);
    if which == 0 { return cast<i32>(lab.last_teacher_probs[c] * 1000.0 + 0.5); }
    if which == 1 { return lab.last_scratch_votes[c]; }
    if which == 2 { return lab.last_kd_votes[c]; }
    if which == 3 {
        if cls == 0 { return lab.last_teacher_pred; }
        if cls == 1 { return lab.last_scratch_pred; }
        if cls == 2 { return lab.last_kd_pred; }
        return cast<i32>(core::popcount_u64(lab.last_fp));
    }
    return 0;
}

export "browser" fn distill_fp_bit(handle: usize, bit_idx: i32) -> i32 {
    if handle == 0 or bit_idx < 0 or bit_idx >= 64 { return 0; }
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let lab = unsafe &p.*;
    let b = (lab.last_fp >> cast<u64>(bit_idx)) & cast<u64>(1);
    return if b != 0 { cast<i32>(1) } else { cast<i32>(0) };
}

export "browser" fn distill_bench(handle: usize, is_vm: i32, iters: i32) -> i32 {
    if handle == 0 { return 0; }
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm exclusive access.
    let lab = unsafe &var p.*;
    return dl_lab_bench(lab, is_vm != 0, cast<i64>(iters));
}

