import griffith::core;
import griffith::data;
import griffith::lut;
import griffith::model;
import griffith::synth;
import std::array;
import std::mem;
import std::string;

// Host callbacks implemented by the JavaScript adapter.
// read_input slots: 0=glgpt binary bytes, 1=UTF-8 text bytes (prompt or Japanese sentence).
extern "browser" fn read_input(slot: i32, offset: i32, destination: []u8) -> usize
// give_bytes kinds: 0=generated Kizu AOT code, 1=Griffith IR JSON.
extern "browser" fn give_bytes(kind: i32, data: []u8) -> void

fn read_host_slot(allocator: Allocator, slot: i32, total_len: i64) -> mem::Error!string::String {
    var out = string::new(allocator);
    errdefer out.deinit(allocator);
    if total_len <= 0 {
        return move out;
    }
    var chunk = [8192]u8{};
    let writable = chunk.as_mut_bytes();
    var offset: i64 = 0;
    while offset < total_len {
        // SAFETY: read_input writes at most 8192 bytes into writable during this synchronous call.
        let got = cast<i64>(unsafe read_input(slot, cast<i32>(offset), writable));
        if got <= 0 {
            break;
        }
        try out.append_bytes(allocator, writable[0..got]);
        offset = offset + got;
    }
    return move out;
}

// =========================================================================
// LAB-01 (draw/): Live 5x5 Differentiable LUT Trainer -> Logic Synthesis
// =========================================================================

fn param_mode_from_i32(v: i32) -> lut::ParamMode {
    if v == 1 {
        return lut::ParamMode::Softmax;
    }
    return lut::ParamMode::Warp;
}

export "browser" fn live_create(seed: u32, param_mode: i32) -> usize {
    let allocator = mem::page_allocator();
    if trainer_new(allocator, cast<u64>(seed), param_mode_from_i32(param_mode)) |trainer| {
        let words = (cast<i64>(mem::size_of<LiveTrainer>()) + 7) / 8;
        var backing = array::new<u64>(allocator);
        for 0..words |_| {
            if backing.append(allocator, cast<u64>(0)) {} else |_| {
                trainer.deinit(allocator);
                backing.deinit(allocator);
                return 0;
            }
        }
        let slots = backing.as_mut_slice();
        // SAFETY: backing has 8-byte alignment and at least size_of<LiveTrainer>() bytes.
        let p = unsafe cast<ptr<LiveTrainer>>(mut_ptr_of(slots));
        // SAFETY: p points to valid storage in backing, leaked below for the lifetime of this session.
        unsafe ptr_write(p, move trainer);
        // SAFETY: opaque handle returned to JS and passed back only to live_* exports.
        let addr = unsafe int_from_ptr<usize>(p);
        mem::leak<array::Array<u64>>(move backing);
        return addr;
    } else |_| {
        return 0;
    }
}

export "browser" fn live_reseed(handle: usize, seed: u32) -> i32 {
    if handle == 0 { return 1; }
    // SAFETY: handle came from live_create and stays valid for this Wasm instance.
    let p = unsafe ptr_from_int<ptr<LiveTrainer>>(handle);
    // SAFETY: single-threaded browser Wasm exclusive access.
    let t = unsafe &var p.*;
    trainer_reseed(t, cast<u64>(seed));
    return 0;
}

