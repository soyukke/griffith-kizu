export "browser" fn distill_metric_milli(handle: usize, which: i32) -> i32 {
    if handle == 0 { return 0; }
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let lab = unsafe &p.*;
    if which == 0 { return cast<i32>(lab.teacher_train_acc * 1000.0 + 0.5); }
    if which == 1 { return cast<i32>(lab.teacher_val_acc * 1000.0 + 0.5); }
    if which == 2 { return cast<i32>(lab.scratch_loss * 1000.0 + 0.5); }
    if which == 3 { return cast<i32>(lab.scratch_train_acc * 1000.0 + 0.5); }
    if which == 4 { return cast<i32>(lab.scratch_val_acc * 1000.0 + 0.5); }
    if which == 5 { return cast<i32>(lab.kd_loss * 1000.0 + 0.5); }
    if which == 6 { return cast<i32>(lab.kd_train_acc * 1000.0 + 0.5); }
    if which == 7 { return cast<i32>(lab.kd_val_acc * 1000.0 + 0.5); }
    if which == 8 { return cast<i32>(lab.kd_teacher_agree * 1000.0 + 0.5); }
    if which == 9 { return cast<i32>(lab.student_step); }
    return 0;
}

