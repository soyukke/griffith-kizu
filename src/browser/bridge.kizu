    return trainer_infer(t, bits, use_hard != 0);
}

export "browser" fn live_vote(handle: usize, cls: i32, use_hard: i32) -> i32 {
    if handle == 0 or cls < 0 or cls >= 3 { return 0; }
    // SAFETY: handle came from live_create and stays valid for this Wasm instance.
    let p = unsafe ptr_from_int<ptr<LiveTrainer>>(handle);
    // SAFETY: single-threaded browser Wasm read access.
    let t = unsafe &p.*;
    if use_hard != 0 {
        return t.test_hard_votes[cast<i64>(cls)];
    }
    return cast<i32>(t.test_soft_probs[cast<i64>(cls)] * 1000.0 + 0.5);
}

export "browser" fn live_wire_milli(handle: usize, is_opt: i32, wire_id: i32) -> i32 {
    if handle == 0 or wire_id < 0 { return 0; }
    // SAFETY: handle came from live_create and stays valid for this Wasm instance.
    let p = unsafe ptr_from_int<ptr<LiveTrainer>>(handle);
    // SAFETY: single-threaded browser Wasm read access.
    let t = unsafe &p.*;
    let wi = cast<i64>(wire_id);
    if is_opt != 0 {
        if wi >= t.test_opt_wires.len() { return 0; }
        let ow = t.test_opt_wires.as_slice();
        return if ow[wi] != 0 { cast<i32>(1000) } else { cast<i32>(0) };
    }
    if wi >= t.test_raw_wires.len() { return 0; }
    let rw = t.test_raw_wires.as_slice();
    return cast<i32>(rw[wi] * 1000.0 + 0.5);
}

export "browser" fn live_bench_synth_64way(handle: usize, iters: i32) -> i32 {
    if handle == 0 { return 0; }
    // SAFETY: handle came from live_create and stays valid for this Wasm instance.
    let p = unsafe ptr_from_int<ptr<LiveTrainer>>(handle);
    // SAFETY: single-threaded browser Wasm exclusive access.
    let t = unsafe &var p.*;
    let ck = trainer_bench_synth_64way(t, cast<i64>(iters));
    return cast<i32>(ck & cast<u64>(0x7fffffff));
}

// =========================================================================
// LAB-02 (ladder/): LogicLadderGPT L0 -> L3-C Browser Inference + Attention Map
// =========================================================================

fn load_ladder_inner(allocator: Allocator, byte_len: i64) -> mem::Error!model::LadderRuntime {
    var blob = try read_host_slot(allocator, 0, byte_len);
    defer blob.deinit(allocator);
    let bytes = blob.as_bytes();
    return try model::ladder_runtime_from_bytes(allocator, bytes);
}

export "browser" fn ladder_load(byte_len: i32) -> usize {
    let allocator = mem::page_allocator();
    if load_ladder_inner(allocator, cast<i64>(byte_len)) |rt| {
        let words = (cast<i64>(mem::size_of<model::LadderRuntime>()) + 7) / 8;
        var backing = array::new<u64>(allocator);
        for 0..words |_| {
            if backing.append(allocator, cast<u64>(0)) {} else |_| {
                rt.deinit(allocator);
                backing.deinit(allocator);
                return 0;
            }
        }
        let slots = backing.as_mut_slice();
        // SAFETY: backing has 8-byte alignment and enough storage for LadderRuntime.
        let p = unsafe cast<ptr<model::LadderRuntime>>(mut_ptr_of(slots));
        // SAFETY: p points to uninitialized storage leaked below for this session.
        unsafe ptr_write(p, move rt);
        // SAFETY: opaque handle returned to JS.
        let addr = unsafe int_from_ptr<usize>(p);
        mem::leak<array::Array<u64>>(move backing);
        return addr;
    } else |_| {
        return 0;
    }
}

export "browser" fn ladder_meta(handle: usize, which: i32) -> i32 {
    if handle == 0 { return 0; }
    // SAFETY: handle came from ladder_load.
    let p = unsafe ptr_from_int<ptr<model::LadderRuntime>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let rt = unsafe &p.*;
    if which == 0 { return model::rung_to_i32(rt.rung); }
    if which == 1 { return cast<i32>(rt.vocab_size); }
    if which == 2 { return cast<i32>(rt.seq_len); }
    if which == 3 { return cast<i32>(rt.d_model); }
    if which == 4 { return cast<i32>(rt.n_heads); }
    if which == 5 { return cast<i32>(rt.n_layers); }
    if which == 6 { return rt.soft_ppl_x100; }
    if which == 7 { return rt.hard_ppl_x100; }
    if which == 8 { return rt.train_steps; }
    if which == 9 { return cast<i32>(model::ladder_runtime_logic_gates(rt)); }
    return 0;
}

export "browser" fn ladder_block_muls(handle: usize, seq_pos: i32) -> i32 {
    if handle == 0 { return 0; }
    // SAFETY: handle came from ladder_load.
    let p = unsafe ptr_from_int<ptr<model::LadderRuntime>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let rt = unsafe &p.*;
    return cast<i32>(model::ladder_runtime_block_muls_per_tok(rt, cast<i64>(seq_pos)));
}

fn eval_ladder_bytes_inner(allocator: Allocator, rt: &var model::LadderRuntime, byte_len: i64) -> mem::Error!i32 {
    var text = try read_host_slot(allocator, 1, byte_len);
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    let max_t = rt.seq_len;

    if rt.is_bpe {
        var enc = array::new<i32>(allocator);
        defer enc.deinit(allocator);
        try data::bpe_encode(allocator, &rt.bpe, bytes, &var enc);
        let total = enc.len();
        let use_len = if total > max_t { max_t } else { total };
        if use_len <= 0 { return 0; }
        let start = total - use_len;
        let enc_s = enc.as_slice();
        let sub = enc_s[start..total];
        model::ladder_runtime_forward(rt, sub, use_len);

        // Emit NUL-separated UTF-8 token pieces for the active window (kind=3)
        var joined = string::new(allocator);
        defer joined.deinit(allocator);
        for 0..use_len |i| {
            if i > 0 { try joined.append_byte(allocator, cast<u8>(0)); }
            let piece = data::bpe_token_bytes(&rt.bpe, sub[i]);
            try joined.append_bytes(allocator, piece);
        }
        let jb = joined.as_bytes();
        // SAFETY: give_bytes synchronously copies bytes inside JS host.
        unsafe give_bytes(3, jb);
        return cast<i32>(use_len);
    }

    let n = mem::len(bytes);
    let use_len = if n > max_t { max_t } else { n };
    if use_len <= 0 {
        return 0;
    }
    let start = n - use_len;
    var toks = [128]i32{};
    let ts = toks.as_mut_slice();
    let b2i = rt.byte_to_id.as_slice();
    for 0..use_len |i| {
        ts[i] = b2i[cast<i64>(bytes[start + i])];
    }
    let tok_s = toks.as_slice();
    model::ladder_runtime_forward(rt, tok_s, use_len);
    return cast<i32>(use_len);
}

export "browser" fn ladder_eval_bytes(handle: usize, byte_len: i32) -> i32 {
    if handle == 0 { return 0; }
    let allocator = mem::page_allocator();
    // SAFETY: handle came from ladder_load.
    let p = unsafe ptr_from_int<ptr<model::LadderRuntime>>(handle);
    // SAFETY: single-threaded Wasm exclusive access.
    let rt = unsafe &var p.*;
    return eval_ladder_bytes_inner(allocator, rt, cast<i64>(byte_len)) catch 0;
}

export "browser" fn ladder_sample_byte(handle: usize, temp_milli: i32, reseed: u32) -> i32 {
    if handle == 0 { return 32; }
    // SAFETY: handle came from ladder_load.
    let p = unsafe ptr_from_int<ptr<model::LadderRuntime>>(handle);
    // SAFETY: single-threaded Wasm exclusive access.
    let rt = unsafe &var p.*;
    if reseed != 0 {
        rt.rng = core::rng_new(cast<u64>(reseed));
    }
    let tid = model::ladder_runtime_sample_next(rt, cast<f32>(temp_milli) * 0.001);
    let i2b = rt.id_to_byte.as_bytes();
    let idx = cast<i64>(tid);
    if idx < 0 or idx >= rt.vocab_size { return 32; }
    return cast<i32>(i2b[idx]);
}

/// Samples next token for BPE models: emits exact UTF-8 token bytes via give_bytes(kind=2) and returns token id.
export "browser" fn ladder_sample_bpe(handle: usize, temp_milli: i32, reseed: u32) -> i32 {
    if handle == 0 { return -1; }
    // SAFETY: handle came from ladder_load.
    let p = unsafe ptr_from_int<ptr<model::LadderRuntime>>(handle);
    // SAFETY: single-threaded Wasm exclusive access.
    let rt = unsafe &var p.*;
    if reseed != 0 {
        rt.rng = core::rng_new(cast<u64>(reseed));
    }
    let tid = model::ladder_runtime_sample_next(rt, cast<f32>(temp_milli) * 0.001);
    let piece = data::bpe_token_bytes(&rt.bpe, tid);
    // SAFETY: give_bytes synchronously copies UTF-8 bytes inside JS host.
    unsafe give_bytes(2, piece);
    return tid;
}

/// Emits the `rank`-th highest probability BPE token's UTF-8 bytes via give_bytes(kind=2) and returns prob_milli.
export "browser" fn ladder_top_bpe(handle: usize, rank: i32) -> i32 {
    if handle == 0 or rank < 0 or rank >= 8 { return 0; }
    // SAFETY: handle came from ladder_load.
    let p = unsafe ptr_from_int<ptr<model::LadderRuntime>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let rt = unsafe &p.*;
    let v = rt.vocab_size;
    let pr = rt.last_probs.as_slice();
    var used = [2048]i32{};
    let us = used.as_mut_slice();
    var best_id: i64 = 0;
    var best_p: f32 = -1.0;
    let target_r = cast<i64>(rank) + 1;
    for 0..target_r |_| {
        best_id = 0;
        best_p = -1.0;
        for 0..v |c| {
            if us[c] == 0 and pr[c] > best_p {
                best_p = pr[c];
                best_id = c;
            }
        }
        us[best_id] = 1;
    }
    let piece = data::bpe_token_bytes(&rt.bpe, cast<i32>(best_id));
    // SAFETY: give_bytes synchronously copies UTF-8 bytes inside JS host.
    unsafe give_bytes(2, piece);
    return cast<i32>(best_p * 1000.0 + 0.5);
}

export "browser" fn ladder_attn_milli(handle: usize, layer: i32, head: i32, q: i32, k: i32) -> i32 {
    if handle == 0 { return 0; }
    // SAFETY: handle came from ladder_load.
    let p = unsafe ptr_from_int<ptr<model::LadderRuntime>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let rt = unsafe &p.*;
    let l = cast<i64>(layer);
    let h = cast<i64>(head);
    let qi = cast<i64>(q);
    let ki = cast<i64>(k);
    if l < 0 or l >= rt.n_layers or h < 0 or h >= rt.n_heads or qi < 0 or qi >= rt.seq_len or ki < 0 or ki >= rt.seq_len {
        return 0;
    }
    let idx = ((l * rt.n_heads + h) * rt.seq_len + qi) * rt.seq_len + ki;
    let am = rt.attn_maps.as_slice();
    return cast<i32>(am[idx] * 1000.0 + 0.5);
}

/// Returns packed `(prob_milli << 8) | ascii_byte` for the `rank`-th highest probability next token (0..4).
export "browser" fn ladder_top_token(handle: usize, rank: i32) -> i32 {
    if handle == 0 or rank < 0 or rank >= 8 { return 0; }
    // SAFETY: handle came from ladder_load.
    let p = unsafe ptr_from_int<ptr<model::LadderRuntime>>(handle);
    // SAFETY: single-threaded Wasm read access.
    let rt = unsafe &p.*;
    let v = rt.vocab_size;
    let pr = rt.last_probs.as_slice();
    let i2b = rt.id_to_byte.as_bytes();
    var used = [128]i32{};
    let us = used.as_mut_slice();
    var best_id: i64 = 0;
    var best_p: f32 = -1.0;
    let target_r = cast<i64>(rank) + 1;
    for 0..target_r |_| {
        best_id = 0;
        best_p = -1.0;
        for 0..v |c| {
            if us[c] == 0 and pr[c] > best_p {
                best_p = pr[c];
                best_id = c;
            }
        }
        us[best_id] = 1;
    }
    let pm = cast<i32>(best_p * 1000.0 + 0.5);
    let b = cast<i32>(i2b[best_id]);
    return (pm << 8) | (b & 255);
}

// =========================================================================
// LAB-03 (distill/): Japanese Real-Time Router Distillation + Logic Synthesis
// =========================================================================

export "browser" fn distill_create(seed: u32) -> usize {
    let allocator = mem::page_allocator();
    if dl_lab_new(allocator, cast<u64>(seed)) |lab| {
        let words = (cast<i64>(mem::size_of<DistillLab>()) + 7) / 8;
        var backing = array::new<u64>(allocator);
        for 0..words |_| {
            if backing.append(allocator, cast<u64>(0)) {} else |_| {
                lab.deinit(allocator);
                backing.deinit(allocator);
                return 0;
            }
        }
        let slots = backing.as_mut_slice();
        // SAFETY: backing has 8-byte alignment and enough storage for DistillLab.
        let p = unsafe cast<ptr<DistillLab>>(mut_ptr_of(slots));
        // SAFETY: p points to storage leaked below for this session.
        unsafe ptr_write(p, move lab);
        // SAFETY: opaque handle returned to JS.
        let addr = unsafe int_from_ptr<usize>(p);
        mem::leak<array::Array<u64>>(move backing);
        return addr;
    } else |_| {
        return 0;
    }
}

export "browser" fn distill_clear(handle: usize) -> i32 {
    if handle == 0 { return 1; }
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm exclusive access.
    let lab = unsafe &var p.*;
    dl_lab_clear(lab);
    return 0;
}

fn distill_add_slot_inner(allocator: Allocator, lab: &var DistillLab, byte_len: i64, label: i32, split: i32) -> mem::Error!i32 {
    var text = try read_host_slot(allocator, 1, byte_len);
    defer text.deinit(allocator);
    let bytes = text.as_bytes();
    return cast<i32>(dl_lab_add_text(lab, bytes, label, split));
}

export "browser" fn distill_add_text(handle: usize, byte_len: i32, label: i32, split: i32) -> i32 {
    if handle == 0 { return -1; }
    let allocator = mem::page_allocator();
    // SAFETY: handle came from distill_create.
    let p = unsafe ptr_from_int<ptr<DistillLab>>(handle);
    // SAFETY: single-threaded Wasm exclusive access.
    let lab = unsafe &var p.*;
    return distill_add_slot_inner(allocator, lab, cast<i64>(byte_len), label, split) catch -1;
}

