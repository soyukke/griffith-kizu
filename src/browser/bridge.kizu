fn eval_single_aot(task_id: i32, input_mask: i32) -> i32 {
    let m = cast<u64>(input_mask);
    if task_id == 0 {
        var in_bits = [2]u64{
            if (m & 1) != 0 { cast<u64>(1) } else { cast<u64>(0) },
            if (m & 2) != 0 { cast<u64>(1) } else { cast<u64>(0) },
        };
        var out_bits = [32]u64{};
        let ib = in_bits.as_slice();
        let ob = out_bits.as_mut_slice();
        aot_xor_64(ib, ob);
        return cast<i32>(synth::groupsum_argmax_lane(ob, xor_out_count(), 2, 0));
    }
    var in_bits4 = [4]u64{
        if (m & 1) != 0 { cast<u64>(1) } else { cast<u64>(0) },
        if (m & 2) != 0 { cast<u64>(1) } else { cast<u64>(0) },
        if (m & 4) != 0 { cast<u64>(1) } else { cast<u64>(0) },
        if (m & 8) != 0 { cast<u64>(1) } else { cast<u64>(0) },
    };
    let ib4 = in_bits4.as_slice();
    if task_id == 1 {
        var pout = [1]u64{};
        let po = pout.as_mut_slice();
        aot_parity4_64(ib4, po);
        return cast<i32>(po[0] & cast<u64>(1));
    }
    var aout = [3]u64{};
    let ao = aout.as_mut_slice();
    aot_adder2_64(ib4, ao);
    let b0 = ao[0] & cast<u64>(1);
    let b1 = ao[1] & cast<u64>(1);
    let b2 = ao[2] & cast<u64>(1);
    return cast<i32>(b0 | (b1 << 1) | (b2 << 2));
}

fn eval_single_vm_inner(task_id: i32, input_mask: i32) -> mem::Error!i32 {
    let allocator = mem::page_allocator();
    let m = cast<u64>(input_mask);
    if task_id == 0 {
        var c = try build_vm_xor(allocator);
        defer c.deinit(allocator);
        var scratch = try core::alloc_u64(allocator, 2 + c.gate_count + 1);
        defer scratch.deinit(allocator);
        var out_bits = try core::alloc_u64(allocator, c.out_wires.len());
        defer out_bits.deinit(allocator);
        var in_bits = [2]u64{
            if (m & 1) != 0 { cast<u64>(1) } else { cast<u64>(0) },
            if (m & 2) != 0 { cast<u64>(1) } else { cast<u64>(0) },
        };
        let ib = in_bits.as_slice();
        let sc = scratch.as_mut_slice();
        let ob = out_bits.as_mut_slice();
        synth::eval_circuit_vm_u64(&c, ib, sc, ob);
        return cast<i32>(synth::groupsum_argmax_lane(ob, c.out_wires.len(), 2, 0));
    }
    var in_bits4 = [4]u64{
        if (m & 1) != 0 { cast<u64>(1) } else { cast<u64>(0) },
        if (m & 2) != 0 { cast<u64>(1) } else { cast<u64>(0) },
        if (m & 4) != 0 { cast<u64>(1) } else { cast<u64>(0) },
        if (m & 8) != 0 { cast<u64>(1) } else { cast<u64>(0) },
    };
    let ib4 = in_bits4.as_slice();
    if task_id == 1 {
        var c = try build_vm_parity4(allocator);
        defer c.deinit(allocator);
        var scratch = try core::alloc_u64(allocator, 4 + c.gate_count + 1);
        defer scratch.deinit(allocator);
        var pout = [1]u64{};
        let sc = scratch.as_mut_slice();
        let po = pout.as_mut_slice();
        synth::eval_circuit_vm_u64(&c, ib4, sc, po);
        return cast<i32>(po[0] & cast<u64>(1));
    }
    var c = try build_vm_adder2(allocator);
    defer c.deinit(allocator);
    var scratch = try core::alloc_u64(allocator, 4 + c.gate_count + 1);
    defer scratch.deinit(allocator);
    var aout = [3]u64{};
    let sc = scratch.as_mut_slice();
    let ao = aout.as_mut_slice();
    synth::eval_circuit_vm_u64(&c, ib4, sc, ao);
    let b0 = ao[0] & cast<u64>(1);
    let b1 = ao[1] & cast<u64>(1);
    let b2 = ao[2] & cast<u64>(1);
    return cast<i32>(b0 | (b1 << 1) | (b2 << 2));
}

export "browser" fn lab_eval(task_id: i32, mode: i32, input_mask: i32) -> i32 {
    if mode == 1 {
        return eval_single_aot(task_id, input_mask);
    }
    return eval_single_vm_inner(task_id, input_mask) catch -1;
}

fn bench_vm_inner(task_id: i32, iters: i32) -> mem::Error!u64 {
    let allocator = mem::page_allocator();
    let count = cast<i64>(iters);
    var sink: u64 = 0;
    if task_id == 0 {
        var c = try build_vm_xor(allocator);
        defer c.deinit(allocator);
        var scratch = try core::alloc_u64(allocator, 2 + c.gate_count + 1);
        defer scratch.deinit(allocator);
        var out_bits = try core::alloc_u64(allocator, c.out_wires.len());
        defer out_bits.deinit(allocator);
        var in_bits = [2]u64{ 0b1010, 0b1100 };
        let ib = in_bits.as_mut_slice();
        let sc = scratch.as_mut_slice();
        let ob = out_bits.as_mut_slice();
        for 0..count |i| {
            ib[0] = cast<u64>(i);
            synth::eval_circuit_vm_u64(&c, ib, sc, ob);
            sink = sink ^ ob[0];
        }
        return sink;
    }
    if task_id == 1 {
        var c = try build_vm_parity4(allocator);
        defer c.deinit(allocator);
        var scratch = try core::alloc_u64(allocator, 4 + c.gate_count + 1);
        defer scratch.deinit(allocator);
        var out_bits = [1]u64{};
        var in_bits = [4]u64{ 0xaaaa, 0xcccc, 0xf0f0, 0xff00 };
        let ib = in_bits.as_mut_slice();
        let sc = scratch.as_mut_slice();
        let ob = out_bits.as_mut_slice();
        for 0..count |i| {
            ib[0] = cast<u64>(i);
            synth::eval_circuit_vm_u64(&c, ib, sc, ob);
            sink = sink ^ ob[0];
        }
        return sink;
    }
    var c = try build_vm_adder2(allocator);
    defer c.deinit(allocator);
    var scratch = try core::alloc_u64(allocator, 4 + c.gate_count + 1);
    defer scratch.deinit(allocator);
    var out_bits = [3]u64{};
    var in_bits = [4]u64{ 0xaaaa, 0xcccc, 0xf0f0, 0xff00 };
    let ib = in_bits.as_mut_slice();
    let sc = scratch.as_mut_slice();
    let ob = out_bits.as_mut_slice();
    for 0..count |i| {
        ib[0] = cast<u64>(i);
        synth::eval_circuit_vm_u64(&c, ib, sc, ob);
        sink = sink ^ ob[0] ^ ob[1] ^ ob[2];
    }
    return sink;
}

export "browser" fn lab_bench_64way(task_id: i32, mode: i32, iters: i32) -> i32 {
    if mode == 0 {
        let s = bench_vm_inner(task_id, iters) catch cast<u64>(0);
        return cast<i32>(s & cast<u64>(0x7fffffff));
    }
    let count = cast<i64>(iters);
    var sink: u64 = 0;
    if task_id == 0 {
        var in_bits = [2]u64{ 0b1010, 0b1100 };
        var out_bits = [32]u64{};
        let ib = in_bits.as_mut_slice();
        let ob = out_bits.as_mut_slice();
        for 0..count |i| {
            ib[0] = cast<u64>(i);
            aot_xor_64(ib, ob);
            sink = sink ^ ob[0];
        }
        return cast<i32>(sink & cast<u64>(0x7fffffff));
    }
    if task_id == 1 {
        var in_bits = [4]u64{ 0xaaaa, 0xcccc, 0xf0f0, 0xff00 };
        var out_bits = [1]u64{};
        let ib = in_bits.as_mut_slice();
        let ob = out_bits.as_mut_slice();
        for 0..count |i| {
            ib[0] = cast<u64>(i);
            aot_parity4_64(ib, ob);
            sink = sink ^ ob[0];
        }
        return cast<i32>(sink & cast<u64>(0x7fffffff));
    }
    var in_bits = [4]u64{ 0xaaaa, 0xcccc, 0xf0f0, 0xff00 };
    var out_bits = [3]u64{};
    let ib = in_bits.as_mut_slice();
    let ob = out_bits.as_mut_slice();
    for 0..count |i| {
        ib[0] = cast<u64>(i);
        aot_adder2_64(ib, ob);
        sink = sink ^ ob[0] ^ ob[1] ^ ob[2];
    }
    return cast<i32>(sink & cast<u64>(0x7fffffff));
}

