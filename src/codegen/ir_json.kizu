import griffith::synth;
import std::fmt;
import std::mem;
import std::string;

fn hex_digit(nibble: u64) -> u8 {
    if nibble < 10 {
        return cast<u8>(48 + nibble);
    }
    return cast<u8>(87 + nibble);
}

fn append_nl(allocator: Allocator, out: &var string::String) -> mem::Error!void {
    try out.append_byte(allocator, cast<u8>(10));
    return;
}

fn append_q(allocator: Allocator, out: &var string::String) -> mem::Error!void {
    try out.append_byte(allocator, cast<u8>(34));
    return;
}

fn append_qstr(allocator: Allocator, out: &var string::String, text: []u8) -> mem::Error!void {
    try append_q(allocator, out);
    try out.append_bytes(allocator, text);
    try append_q(allocator, out);
    return;
}

fn append_key(allocator: Allocator, out: &var string::String, key: []u8) -> mem::Error!void {
    try append_qstr(allocator, out, key);
    try out.append_bytes(allocator, ": ");
    return;
}

fn append_hex_tt(allocator: Allocator, out: &var string::String, tt: u64, arity: i64) -> mem::Error!void {
    try out.append_bytes(allocator, "0x");
    var nibbles: i64 = 1;
    if arity == 2 {
        nibbles = 1;
    } else if arity == 3 {
        nibbles = 2;
    } else if arity == 4 {
        nibbles = 4;
    } else if arity == 5 {
        nibbles = 8;
    } else if arity >= 6 {
        nibbles = 16;
    }
    var i = nibbles - 1;
    while i >= 0 {
        let nib = (tt >> cast<u64>(i * 4)) & cast<u64>(15);
        try out.append_byte(allocator, hex_digit(nib));
        i = i - 1;
    }
    return;
}

pub fn emit_griffith_ir_json(
    allocator: Allocator,
    c: &synth::Circuit,
    name: []u8,
    out: &var string::String
) -> mem::Error!void {
    let ga = c.gate_arity.as_slice();
    let gp = c.gate_pins.as_slice();
    let gt = c.gate_tt.as_slice();
    let ow = c.out_wires.as_slice();
    let out_count = c.out_wires.len();

    try out.append_bytes(allocator, "{");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "  ");
    try append_key(allocator, out, "format");
    try append_qstr(allocator, out, "griffith-ir");
    try out.append_bytes(allocator, ",");
    try append_nl(allocator, out);

    try out.append_bytes(allocator, "  ");
    try append_key(allocator, out, "version");
    try append_qstr(allocator, out, "0.2");
    try out.append_bytes(allocator, ",");
    try append_nl(allocator, out);

    try out.append_bytes(allocator, "  ");
    try append_key(allocator, out, "metadata");
    try out.append_bytes(allocator, "{ ");
    try append_key(allocator, out, "name");
    try append_qstr(allocator, out, name);
    try out.append_bytes(allocator, ", ");
    try append_key(allocator, out, "producer");
    try append_qstr(allocator, out, "griffith-kizu");
    try out.append_bytes(allocator, ", ");
    try append_key(allocator, out, "gate_count");
    try fmt::append_i64(allocator, out, c.gate_count);
    try out.append_bytes(allocator, " },");
    try append_nl(allocator, out);

    try out.append_bytes(allocator, "  ");
    try append_key(allocator, out, "inputs");
    try out.append_bytes(allocator, "[{ ");
    try append_key(allocator, out, "id");
    try append_qstr(allocator, out, "in");
    try out.append_bytes(allocator, ", ");
    try append_key(allocator, out, "width");
    try fmt::append_i64(allocator, out, c.input_width);
    try out.append_bytes(allocator, " }],");
    try append_nl(allocator, out);

    let final_out_w = if c.group_sum_k > 0 { c.group_sum_k } else { out_count };
    try out.append_bytes(allocator, "  ");
    try append_key(allocator, out, "outputs");
    try out.append_bytes(allocator, "[{ ");
    try append_key(allocator, out, "id");
    try append_qstr(allocator, out, "out");
    try out.append_bytes(allocator, ", ");
    try append_key(allocator, out, "width");
    try fmt::append_i64(allocator, out, final_out_w);
    try out.append_bytes(allocator, " }],");
    try append_nl(allocator, out);

    try out.append_bytes(allocator, "  ");
    try append_key(allocator, out, "nodes");
    try out.append_bytes(allocator, "[");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "    {");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "      ");
    try append_key(allocator, out, "id");
    try append_qstr(allocator, out, "dag");
    try out.append_bytes(allocator, ",");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "      ");
    try append_key(allocator, out, "type");
    try append_qstr(allocator, out, "lut_dag");
    try out.append_bytes(allocator, ",");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "      ");
    try append_key(allocator, out, "params");
    try out.append_bytes(allocator, "{");
    try append_nl(allocator, out);

    try out.append_bytes(allocator, "        ");
    try append_key(allocator, out, "in_width");
    try fmt::append_i64(allocator, out, c.input_width);
    try out.append_bytes(allocator, ",");
    try append_nl(allocator, out);

    try out.append_bytes(allocator, "        ");
    try append_key(allocator, out, "out_width");
    try fmt::append_i64(allocator, out, out_count);
    try out.append_bytes(allocator, ",");
    try append_nl(allocator, out);

    try out.append_bytes(allocator, "        ");
    try append_key(allocator, out, "gates");
    try out.append_bytes(allocator, "[");
    try append_nl(allocator, out);

    for 0..c.gate_count |g| {
        let arity = cast<i64>(ga[g]);
        try out.append_bytes(allocator, "          { ");
        try append_key(allocator, out, "id");
        try fmt::append_i64(allocator, out, c.input_width + g);
        try out.append_bytes(allocator, ", ");
        try append_key(allocator, out, "arity");
        try fmt::append_i64(allocator, out, arity);
        try out.append_bytes(allocator, ", ");
        try append_key(allocator, out, "pins");
        try out.append_bytes(allocator, "[");
        for 0..arity |p| {
            if p > 0 {
                try out.append_bytes(allocator, ", ");
            }
            try fmt::append_i64(allocator, out, cast<i64>(gp[g * 6 + p]));
        }
        try out.append_bytes(allocator, "], ");
        try append_key(allocator, out, "tt");
        try append_q(allocator, out);
        try append_hex_tt(allocator, out, gt[g], arity);
        try append_q(allocator, out);
        try out.append_bytes(allocator, " }");
        if g + 1 < c.gate_count {
            try out.append_bytes(allocator, ",");
        }
        try append_nl(allocator, out);
    }

    try out.append_bytes(allocator, "        ],");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "        ");
    try append_key(allocator, out, "out_wires");
    try out.append_bytes(allocator, "[");
    for 0..out_count |i| {
        if i > 0 {
            try out.append_bytes(allocator, ", ");
        }
        try fmt::append_i64(allocator, out, cast<i64>(ow[i]));
    }
    try out.append_bytes(allocator, "]");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "      }");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "    }");

    if c.group_sum_k > 0 {
        try out.append_bytes(allocator, ",");
        try append_nl(allocator, out);
        try out.append_bytes(allocator, "    {");
        try append_nl(allocator, out);
        try out.append_bytes(allocator, "      ");
        try append_key(allocator, out, "id");
        try append_qstr(allocator, out, "readout");
        try out.append_bytes(allocator, ",");
        try append_nl(allocator, out);
        try out.append_bytes(allocator, "      ");
        try append_key(allocator, out, "type");
        try append_qstr(allocator, out, "group_sum");
        try out.append_bytes(allocator, ",");
        try append_nl(allocator, out);
        try out.append_bytes(allocator, "      ");
        try append_key(allocator, out, "params");
        try out.append_bytes(allocator, "{ ");
        try append_key(allocator, out, "in_width");
        try fmt::append_i64(allocator, out, out_count);
        try out.append_bytes(allocator, ", ");
        try append_key(allocator, out, "k");
        try fmt::append_i64(allocator, out, c.group_sum_k);
        try out.append_bytes(allocator, " }");
        try append_nl(allocator, out);
        try out.append_bytes(allocator, "    }");
        try append_nl(allocator, out);
    } else {
        try append_nl(allocator, out);
    }

    try out.append_bytes(allocator, "  ],");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "  ");
    try append_key(allocator, out, "edges");
    try out.append_bytes(allocator, "[");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "    { ");
    try append_key(allocator, out, "src");
    try append_qstr(allocator, out, "in");
    try out.append_bytes(allocator, ", ");
    try append_key(allocator, out, "dst");
    try append_qstr(allocator, out, "dag");
    try out.append_bytes(allocator, " },");
    try append_nl(allocator, out);
    if c.group_sum_k > 0 {
        try out.append_bytes(allocator, "    { ");
        try append_key(allocator, out, "src");
        try append_qstr(allocator, out, "dag");
        try out.append_bytes(allocator, ", ");
        try append_key(allocator, out, "dst");
        try append_qstr(allocator, out, "readout");
        try out.append_bytes(allocator, " },");
        try append_nl(allocator, out);
        try out.append_bytes(allocator, "    { ");
        try append_key(allocator, out, "src");
        try append_qstr(allocator, out, "readout");
        try out.append_bytes(allocator, ", ");
        try append_key(allocator, out, "dst");
        try append_qstr(allocator, out, "out");
        try out.append_bytes(allocator, " }");
        try append_nl(allocator, out);
    } else {
        try out.append_bytes(allocator, "    { ");
        try append_key(allocator, out, "src");
        try append_qstr(allocator, out, "dag");
        try out.append_bytes(allocator, ", ");
        try append_key(allocator, out, "dst");
        try append_qstr(allocator, out, "out");
        try out.append_bytes(allocator, " }");
        try append_nl(allocator, out);
    }
    try out.append_bytes(allocator, "  ]");
    try append_nl(allocator, out);
    try out.append_bytes(allocator, "}");
    try append_nl(allocator, out);
    return;
}
