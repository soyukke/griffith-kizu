import griffith::core;
import std::math;
import std::testing;

pub fn pow2(n: i64) -> i64 {
    return cast<i64>(cast<u64>(1) << cast<u64>(n));
}

pub fn gate_table_n2_bit(gate: i64, k: i64) -> f32 {
    var shift: u64 = 3;
    if k == 1 {
        shift = 1;
    } else if k == 2 {
        shift = 2;
    } else if k == 3 {
        shift = 0;
    }
    if ((cast<u64>(gate) >> shift) & cast<u64>(1)) != 0 {
        return 1.0;
    }
    return 0.0;
}

pub fn gate_table_n2_mask(gate: i64) -> u64 {
    var mask: u64 = 0;
    for 0..4 |k| {
        if gate_table_n2_bit(gate, k) > 0.5 {
            mask = mask | (cast<u64>(1) << cast<u64>(k));
        }
    }
    return mask;
}

pub fn compute_basis_butterfly(
    x_pins: []f32,
    n_inputs: i64,
    basis_out: &var []f32,
    inter_out: &var []f32
) -> void {
    var cur = [64]f32{};
    var next = [64]f32{};
    let cur_s = cur.as_mut_slice();
    let next_s = next.as_mut_slice();
    cur_s[0] = 1.0;
    var size: i64 = 1;
    for 0..n_inputs |j| {
        let offset = size - 1;
        for 0..size |m| {
            inter_out[offset + m] = cur_s[m];
        }
        let xj = x_pins[j];
        let one_minus = 1.0 - xj;
        for 0..size |m| {
            let v = cur_s[m];
            next_s[m] = v * one_minus;
            next_s[size + m] = v * xj;
        }
        size = size * 2;
        for 0..size |m| {
            cur_s[m] = next_s[m];
        }
    }
    for 0..size |m| {
        basis_out[m] = cur_s[m];
    }
    return;
}

pub fn butterfly_backward(
    grad_basis: []f32,
    x_pins: []f32,
    inter: []f32,
    n_inputs: i64,
    grad_pins_out: &var []f32
) -> void {
    let total = pow2(n_inputs);
    var cur = [64]f32{};
    var next = [64]f32{};
    let cur_s = cur.as_mut_slice();
    let next_s = next.as_mut_slice();
    for 0..total |m| {
        cur_s[m] = grad_basis[m];
    }
    var cur_size = total;
    var j = n_inputs - 1;
    while j >= 0 {
        let half = cur_size / 2;
        let offset = half - 1;
        let xj = x_pins[j];
        let one_minus = 1.0 - xj;
        var g_pin: f32 = 0.0;
        for 0..half |m| {
            let g_lo = cur_s[m];
            let g_hi = cur_s[half + m];
            g_pin = g_pin + (g_hi - g_lo) * inter[offset + m];
            next_s[m] = g_lo * one_minus + g_hi * xj;
        }
        grad_pins_out[j] = g_pin;
        cur_size = half;
        for 0..cur_size |m| {
            cur_s[m] = next_s[m];
        }
        j = j - 1;
    }
    return;
}

pub fn compute_wh_basis_butterfly(
    x_pins: []f32,
    n_inputs: i64,
    s_out: &var []f32,
    basis_out: &var []f32,
    inter_out: &var []f32
) -> void {
    var cur = [64]f32{};
    var next = [64]f32{};
    let cur_s = cur.as_mut_slice();
    let next_s = next.as_mut_slice();
    cur_s[0] = 1.0;
    var size: i64 = 1;
    for 0..n_inputs |j| {
        let offset = size - 1;
        for 0..size |m| {
            inter_out[offset + m] = cur_s[m];
        }
        let sj = 1.0 - 2.0 * x_pins[j];
        s_out[j] = sj;
        for 0..size |m| {
            let v = cur_s[m];
            next_s[m] = v;
            next_s[size + m] = v * sj;
        }
        size = size * 2;
        for 0..size |m| {
            cur_s[m] = next_s[m];
        }
    }
    for 0..size |m| {
        basis_out[m] = cur_s[m];
    }
    return;
}

pub fn wh_butterfly_backward(
    grad_basis: []f32,
    s_pins: []f32,
    inter: []f32,
    n_inputs: i64,
    grad_x_pins_out: &var []f32
) -> void {
    let total = pow2(n_inputs);
    var cur = [64]f32{};
    var next = [64]f32{};
    let cur_s = cur.as_mut_slice();
    let next_s = next.as_mut_slice();
    for 0..total |m| {
        cur_s[m] = grad_basis[m];
    }
    var cur_size = total;
    var j = n_inputs - 1;
    while j >= 0 {
        let half = cur_size / 2;
        let offset = half - 1;
        let sj = s_pins[j];
        var g_s: f32 = 0.0;
        for 0..half |m| {
            let g_lo = cur_s[m];
            let g_hi = cur_s[half + m];
            g_s = g_s + g_hi * inter[offset + m];
            next_s[m] = g_lo + g_hi * sj;
        }
        grad_x_pins_out[j] = -2.0 * g_s;
        cur_size = half;
        for 0..cur_size |m| {
            cur_s[m] = next_s[m];
        }
        j = j - 1;
    }
    return;
}

pub fn fwht_in_place(values: &var []f32, n_inputs: i64) -> void {
    let size = pow2(n_inputs);
    var step: i64 = 1;
    while step < size {
        var i: i64 = 0;
        while i < size {
            for 0..step |k| {
                let u = values[i + k];
                let v = values[i + k + step];
                values[i + k] = u + v;
                values[i + k + step] = u - v;
            }
            i = i + step * 2;
        }
        step = step * 2;
    }
    return;
}

pub fn wh_theta_to_logits(theta: []f32, n_inputs: i64, logits_out: &var []f32) -> void {
    let size = pow2(n_inputs);
    for 0..size |i| {
        logits_out[i] = theta[i];
    }
    fwht_in_place(logits_out, n_inputs);
    return;
}

test "basis and fwht consistency" {
    var x = [4]f32{ 0.25, 0.7, 0.4, 0.85 };
    var basis = [64]f32{};
    var inter = [64]f32{};
    let x_s = x.as_slice();
    let basis_m = basis.as_mut_slice();
    let inter_m = inter.as_mut_slice();
    compute_basis_butterfly(x_s, 4, basis_m, inter_m);
    var sum: f64 = 0.0;
    for 0..16 |k| {
        sum = sum + cast<f64>(basis[k]);
    }
    testing::expect(math::abs<f64>(sum - 1.0) < 1e-5);

    var theta = [16]f32{};
    let ts = theta.as_mut_slice();
    for 0..16 |i| {
        ts[i] = cast<f32>(i) * 0.1 - 0.5;
    }
    var logits = [16]f32{};
    let logits_m = logits.as_mut_slice();
    let theta_s = theta.as_slice();
    wh_theta_to_logits(theta_s, 4, logits_m);
    var s_buf = [6]f32{};
    var wh_buf = [64]f32{};
    var wh_inter = [64]f32{};
    let s_m = s_buf.as_mut_slice();
    let wh_m = wh_buf.as_mut_slice();
    let wh_inter_m = wh_inter.as_mut_slice();
    compute_wh_basis_butterfly(x_s, 4, s_m, wh_m, wh_inter_m);
    var dot_wh: f64 = 0.0;
    var dot_std: f64 = 0.0;
    for 0..16 |i| {
        dot_wh = dot_wh + cast<f64>(theta[i]) * cast<f64>(wh_buf[i]);
        dot_std = dot_std + cast<f64>(logits[i]) * cast<f64>(basis[i]);
    }
    testing::expect(math::abs<f64>(dot_wh - dot_std) < 1e-4);

    // Check binary vertex exactness: L[e] == sum_i theta[i] * (-1)^popcount(i & e)
    for 0..16 |e| {
        var ref_val: f64 = 0.0;
        for 0..16 |i| {
            let p = core::popcount_u64(cast<u64>(i & e));
            if p % 2 == 1 {
                ref_val = ref_val - cast<f64>(theta[i]);
            } else {
                ref_val = ref_val + cast<f64>(theta[i]);
            }
        }
        testing::expect(math::abs<f64>(ref_val - cast<f64>(logits[e])) < 1e-4);
    }
}
